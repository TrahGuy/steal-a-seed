--!strict
--==============================================================================
-- THE SECRET POD AND PLANT OF GREENHOLLOW AND STARBLOOM, AS INSERTED
--
-- Four models the owner inserted by hand into the Podnappers Workspace on
-- 2026-10-01 (`Snarlbloomgreenhollowsecret`, `PetalfawnSe`, `greenhollowsecretpod`,
-- `starbloomsecretpod`), lifted here part for part, joint for joint, light and
-- emitter for light and emitter, by a read-only generator the same day. The
-- originals were not moved or changed.
--
-- IT IS DATA, NOT ART DIRECTION. Every size, CFrame, colour, material, surface,
-- attribute, Motor6D and Weld (C0 and C1) is the number that was inserted. The
-- owner's rule: original dimensions, proportions and joint relationships are
-- preserved; nothing is shrunk, normalised or stripped to fit the builders.
--
-- FRAMES. Part CFrames are relative to the model's BASE: for a plant, the
-- authored Base plate's centre dropped to the lowest drawn point (its ground
-- contact); for a pod, the bounding box's bottom centre. The Greenhollow pod is
-- stored yawed 180 degrees so its eyes look along -Z, the front every other pod
-- decorates. Joints point at parts by INDEX, because names repeat (fifteen
-- Thorns, thirteen Bristles). A plant's authored Base part is renamed Footing;
-- the invisible contract `Base` that BuildCreature makes is the PrimaryPart.
--
-- SIZE. One size each, the authored one: SecretModel replays these at scale 1
-- whatever the tier. Random sizes are a later feature, not this file's.
--
-- IDLE. The two plants' idle scripts are NOT here; SecretIdle (client) drives the
-- replayed joint tree by forward kinematics on anchored parts, with the same
-- maths the inserted scripts carried.
--==============================================================================

export type PartSpec = {
	n: string, -- name
	s: string, -- shape: Block | Ball | Cylinder | Wedge
	z: Vector3, -- size
	cf: CFrame, -- relative to the base frame
	c: Color3,
	m: Enum.Material,
	t: number?, -- transparency, 0 when absent
	r: number?, -- reflectance, 0 when absent
	st: boolean?, -- studs on every face unless false
	cs: boolean?, -- CastShadow unless false
	cc: boolean?, -- CanCollide as supplied (the Rain Event forms record it; none of these four do)
	a: { [string]: any }?, -- attributes
	-- Every face's SurfaceType by name -- Top, Bottom, Left, Right, Front, Back -- when they are not all
	-- one kind (PlantForms, 2026-10-03: an Inlet underside, a smooth eye front). Absent: `st` decides.
	sf: { string }?,
	-- PodForms (2026-10-09), the owner's 25 pods: the folder the part sat in (SizeSeam, GlowAccents), a part
	-- the owner anchored besides the root (it stands still in the idle), and the SpecialMesh it is drawn with
	-- (t = MeshType name, s = Scale, o = Offset, and vc / id / tx / n when set).
	g: string?,
	an: boolean?,
	sm: { [string]: any }?,
}

export type JointSpec = {
	k: string, -- Motor6D | Weld
	n: string,
	h: number, -- the part the instance lives in (index)
	a: number, -- Part0 (index)
	b: number, -- Part1 (index)
	c0: CFrame,
	c1: CFrame,
	at: { [string]: any }?, -- the joint's own attributes (PlantForms: a Thornwhorl guard's Outward)
}

export type AttachmentSpec = { n: string, p: number, cf: CFrame }

export type LightSpec = {
	n: string, p: number, range: number, brightness: number, color: Color3, shadows: boolean, enabled: boolean,
	a: { [string]: any }?,
}

export type EmitterSpec = { [string]: any }

-- Added for the Rain Event's supplied models (RainForms, 2026-10-02); none of
-- the four forms below has any. A trail joins two attachments BY INDEX; a
-- billboard is a BillboardGui on a part with its TextLabels.
export type TrailSpec = { [string]: any }
export type BillboardSpec = { [string]: any }
-- Added for the ordinary plants' supplied rigs (PlantForms, 2026-10-03): a Texture on a part by INDEX.
export type TextureSpec = { [string]: any }

export type FormSpec = {
	Source: string,
	Kind: string, -- plant | pod
	Yaw: number,
	Size: Vector3,
	Height: number,
	PartCount: number,
	Base: number, -- the authored Base plate's index (plants), 0 for a pod
	Attributes: { [string]: any },
	Parts: { PartSpec },
	Joints: { JointSpec },
	Attachments: { AttachmentSpec },
	Lights: { LightSpec },
	Emitters: { EmitterSpec },
	Trails: { TrailSpec }?,
	Billboards: { BillboardSpec }?,
	-- A per-joint pose (CFrame attributes of a supplied Configuration) and its
	-- numbers, e.g. the guardian's SleepPose.
	Pose: { [string]: any }?,
	-- PlantForms (2026-10-03): the supplied model's `Unit` attribute, which its idle's distances are
	-- written in, and the scale the owner's Scale tool left it at (Model:GetScale()) -- that Unit was set
	-- before the rescale, so a distance is Unit x ModelScale at the size the form was supplied.
	Unit: number?,
	ModelScale: number?,
	Textures: { TextureSpec }?,
	-- PodForms (2026-10-09): the index of the owner's root part (the one its idle moved), and the owner's
	-- model attributes, kept apart from `Attributes` (which the replay writes onto the built model).
	Root: number?,
	Owner: { [string]: any }?,
	-- The base the owner's pod stood on, left out of the form by name (the owner, 2026-10-09).
	Removed: { string }?,
}

