--==============================================================================
-- THE SEAMS
--
-- Fifteen Motor6Ds: the seven the parent contract requires, plus eight that
-- carry motion the approval actually contains. Nothing here is a joint for its
-- own sake -- every cosmetic seam was added because the two approved poses
-- disagree across it, and the ones that do NOT disagree were left as welds.
--
-- The hood and the eyelids are welded to the head for exactly that reason:
-- measured between the two approved poses, they do not move relative to the
-- head by a thousandth of a stud. The hood "opening" is the whole head-and-hood
-- assembly rising on the neck, and the eyes close by transparency and lid
-- colour. Giving either a seam would be articulation the approval does not
-- contain.
--
-- The three throat ribs DO get seams, because the sac scales rather than moves:
-- a rib welded to a shrinking sac keeps its old offset and floats a third of a
-- stud off the throat, nearly twice its own thickness.
--==============================================================================
export type Seam = {
	seam: string,
	part0: string,
	driver: string,
	members: { string },
}

TanglemireForms.MiremawSeams = {
	{ seam = "Neck", part0 = "Torso", driver = "Head", members = { "LeftEye", "RightEye", "LeftGlint", "RightGlint", "LeftCheek", "RightCheek", "MireDetail_LeftNostril", "MireDetail_RightNostril", "MireDetail_RimBead", "MireDetail_DropStem", "MireDetail_WaterDrop", "HoodCrown", "HoodRim", "LeftHood", "RightHood", "MireDetail_HoodVeinLeft", "MireDetail_HoodVeinCentre", "MireDetail_HoodVeinRight", "CrownShoot1", "CrownShoot2", "MireDetail_LeftLid", "MireDetail_RightLid" } },
