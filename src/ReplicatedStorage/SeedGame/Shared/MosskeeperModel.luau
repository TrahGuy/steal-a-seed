-- Indexes the builder needs.
local RIG: { [string]: number } = {
	dew = 207, plate = 2, head = 33,
}

-- `at`: the floor point under his feet, facing his front (local -Z). Without
-- a `parent` the model is left unparented, for the caller to finish first.
function MosskeeperModel.build(at: CFrame, parent: Instance?): Model
	local base = at
	local model = Instance.new("Model")
	model.Name = "Mosskeeper"
	model:SetAttribute("BuilderId", MosskeeperModel.BuilderId)

	local parts: { BasePart } = {}
	for i, d in ipairs(PARTS) do
		local p: BasePart = if d.w then Instance.new("WedgePart") else Instance.new("Part")
		p.Name = d.n
		if p:IsA("Part") then
			if d.b then
				p.Shape = Enum.PartType.Ball
			elseif d.cy then
				p.Shape = Enum.PartType.Cylinder
			end
		end
		p.Size = Vector3.new(d.z[1], d.z[2], d.z[3])
		p.Material = (Enum.Material :: any)[d.m or "Plastic"]
		p.Color = Color3.fromRGB(d.c[1], d.c[2], d.c[3])
		p.Transparency = d.t or 0
		-- Plastic parts are studded on every face (Neon and Smooth stay smooth).
		local surface = if d.m == nil then Enum.SurfaceType.Studs else Enum.SurfaceType.Smooth
		p.TopSurface = surface
		p.BottomSurface = surface
		p.LeftSurface = surface
		p.RightSurface = surface
		p.FrontSurface = surface
		p.BackSurface = surface
		p.CastShadow = d.cs ~= false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = d.q ~= false
		p.Massless = true
		-- Only the transparent Footing is anchored; the joints hold the rest.
		p.Anchored = i == 1
		p.CFrame = base * CFrame.new(table.unpack(d.cf))
		p.Parent = model
		parts[i] = p
	end
	model.PrimaryPart = parts[1]
	-- The pivot sits on the ground between his feet.
	parts[1].PivotOffset = CFrame.new(0, -0.1, 0)

	for _, j in ipairs(JOINTS) do
		local w = Instance.new(j[1] :: any) :: any
		w.Name = j[2]
		if j[5] then
			w.C0 = CFrame.new(table.unpack(j[5]))
		else
			-- A Hold weld keeps the part exactly where it was just placed.
			w.C0 = parts[j[3]].CFrame:Inverse() * parts[j[4]].CFrame
		end
		if j[6] then
			w.C1 = CFrame.new(table.unpack(j[6]))
		end
		w.Part0 = parts[j[3]]
		w.Part1 = parts[j[4]]
		w.Parent = parts[j[3]]
	end

	-- The Dewdrop glows.
	local light = Instance.new("PointLight")
	light.Name = "DewGlow"
	light.Range = 14
	light.Brightness = 1.2
	light.Color = Color3.new(0.6, 1, 0.8)
	light.Shadows = false
	light.Parent = parts[RIG.dew]

	-- Mint motes drifting up off the Dewdrop.
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "DewSparkle"
	sparkle.Rate = 4
	sparkle.Lifetime = NumberRange.new(1.4, 2.2)
	sparkle.Speed = NumberRange.new(0.6, 1.8)
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28, 0), NumberSequenceKeypoint.new(1, 0.04, 0) })
	sparkle.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1, 0), NumberSequenceKeypoint.new(1, 1, 0) })
	sparkle.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(0.85, 1, 0.92)),
		ColorSequenceKeypoint.new(1, Color3.new(0.45, 1, 0.7)),
	})
	sparkle.LightEmission = 1
	sparkle.LightInfluence = 0
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.SpreadAngle = Vector2.new(50, 50)
	sparkle.Acceleration = Vector3.new(0, 0.8, 0)
	sparkle.Drag = 0.5
	sparkle.EmissionDirection = Enum.NormalId.Top
	sparkle.Parent = parts[RIG.dew]

	if parent then
		model.Parent = parent
	end
	return model
end

return MosskeeperModel
